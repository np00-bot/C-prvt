local function initializeSyncTime()
    local success, res = pcall(function()
        return req({
            Url = SERVER_URL .. "/messages?since=0",
            Method = "GET",
            Headers = { ["User-Agent"] = "Roblox/WinInet" }
        })
    end)

    if success and res and res.StatusCode == 200 then
        local ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
        if ok and type(data) == "table" then
            for _, m in ipairs(data) do
                if tonumber(m.time) and tonumber(m.time) > lastSyncTime then
                    lastSyncTime = tonumber(m.time)
                end
            end
        end
    end
end

-- ==========================================
-- LOGIC: RECEIVING MESSAGES (POLLING OPTIMIZED)
-- ==========================================
local function pollMessages()
    while isPolling do
        task.wait(2)
        local success, res = pcall(function()
            return req({
                Url = SERVER_URL .. "/messages?since=" .. tostring(lastSyncTime),
                Method = "GET",
                Headers = { ["User-Agent"] = "Roblox/WinInet" }
            })
        end)

        if success and res and res.StatusCode == 200 then
            local ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
            if ok and type(data) == "table" then
                for _, m in ipairs(data) do
                    if m.time > lastSyncTime then
                        lastSyncTime = m.time
                        knownUsers[string.lower(m.user)] = m.user

                        -- Process hidden messages (invites & joins) before skipping
                        local invSender, invTarget, invJobId = string.match(m.msg, "^%( 💌 ([%w_]+) Invite ([%w_]+)%) (.+)$")
                        if invSender and invTarget and invJobId then
                            if string.lower(invTarget) == string.lower(LocalPlayer.Name) and invJobId ~= game.JobId then
                                showInviteUI(invSender, invJobId)
                            end
                            continue
                        end

                        if m.hidden then
    if m.msg == "Joined" then
        -- Don't display our own Joined message
        if string.lower(m.user) ~= string.lower(LocalPlayer.Name) then
            displayMessage(
                m.user,
                (m.displayName or m.user) .. " joined the chat.",
                nil,
                false,
                m.displayName
            )
        end
    end

    continue
end
                        if chatMode == "server" and m.jobId ~= game.JobId then continue end
                        
                        local pSender, pTarget, pMsg = string.match(m.msg, "^%( 🔐 ([%w_]+) Private ([%w_]+)%) (.*)$")
                        if pSender and pTarget then
                            if LocalPlayer.Name == pSender then
                                displayMessage(m.user, pMsg, pTarget, true)
                                displayBubble(m.user, pMsg)
                            elseif LocalPlayer.Name == pTarget then
                                displayMessage(m.user, pMsg, pSender, false)
                                displayBubble(m.user, pMsg)
                            end
                            continue
                        end

                        checkMention(m.msg)
                        displayMessage(m.user, m.msg, nil, false, m.displayName)
                        displayBubble(m.user, m.msg)
                    end
                end
            end
        end
    end
end

