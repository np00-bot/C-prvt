local function displayMessage(userName, msg, privateUserTarget, isPrivateSender, receivedDisplayName)
    local displayName = receivedDisplayName or userName

    if not receivedDisplayName then
        local speaker = Players:FindFirstChild(userName)
        if speaker then displayName = speaker.DisplayName end
    end

    local rtsTag, legacyTag = "", ""
    local lowerUser = userName:lower()

    if Admin[lowerUser] then 
        rtsTag, legacyTag = "<font color='#FF0000'>[Admin]</font> ", "[Admin] "
    elseif Owner[lowerUser] then 
        rtsTag, legacyTag = "<font color='#FFFF00'>[👑]</font> ", "[👑] "
    elseif Staff[lowerUser] then 
        rtsTag, legacyTag = "<font color='#00AAFF'>[Staff]</font> ", "[Staff] "
    elseif Mod[lowerUser] then 
        rtsTag, legacyTag = "<font color='#0000FF'>[Mod]</font> ", "[Mod] "
    elseif VIP[lowerUser] then 
        rtsTag, legacyTag = "<font color='#FFFF00'>[VIP]</font> ", "[VIP] "
    end

    local hexColor = getHexColorForUser(userName)
    local msgColor = "#FFFF00"
    local color3Msg = Color3.fromRGB(255, 255, 0)
    
    local rtsTagText = "💬 " .. rtsTag .. displayName .. ":"
    local legacyTagText = "💬 " .. legacyTag .. displayName .. ":"

    if privateUserTarget then
        msgColor = "#FF9632"
        color3Msg = Color3.fromRGB(255, 150, 50)
        if isPrivateSender then
            rtsTagText = "[🔐To " .. privateUserTarget .. "]:"
            legacyTagText = rtsTagText
        else
            rtsTagText = "[🔐From " .. privateUserTarget .. "]:"
            legacyTagText = rtsTagText
        end
    end

    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local formattedText = string.format("<font color='%s'><b>%s</b></font> <font color='%s'><b>%s</b></font>", hexColor, rtsTagText, msgColor, msg)
        local channel = TextChatService.TextChannels:FindFirstChild("RBXSystem")
        if channel then channel:DisplaySystemMessage(formattedText) end
    else
        pcall(function()
            StarterGui:SetCore("ChatMakeSystemMessage", {
                Text = legacyTagText .. " " .. msg,
                Color = color3Msg,
                Font = Enum.Font.SourceSansBold,
                FontSize = Enum.FontSize.Size18
            })
        end)
    end
end

local function checkMention(msg)
    if not msg or msg == "" then return false end
    local pattern = "@" .. string.gsub(LocalPlayer.Name, "([^%w])", "%%%1")

    if string.lower(msg):find(string.lower(pattern), 1, true) then
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "💬 Mention",
                Text = "Someone mentioned you in panel chat",
                Duration = 4
            })
        end)
        return true
    end
    return false
end

