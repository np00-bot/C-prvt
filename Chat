-- ==========================================
-- RECENT MESSAGE PLAYERS
-- ==========================================

local function getRecentMessagePlayers()
    local success, res = pcall(function()
        return req({
            Url = SERVER_URL .. "/messages?since=0",
            Method = "GET",
            Headers = {
                ["User-Agent"] = "Roblox/WinInet"
            }
        })
    end)

    if not success or not res or res.StatusCode ~= 200 then
        return {}
    end

    local ok, data = pcall(function()
        return HttpService:JSONDecode(res.Body)
    end)

    if not ok or type(data) ~= "table" then
        return {}
    end

    -- Get the last 15 messages
    local startIndex = math.max(1, #data - 14)

    local users = {}
    local seen = {}

    -- Iterate newest -> oldest.
    -- This means if someone appears multiple times,
    -- their newest message/jobId is the one we keep.
    for i = #data, startIndex, -1 do
        local m = data[i]

        if type(m) == "table"
            and m.user
            and m.user ~= ""
            and not m.hidden
        then
            local username = tostring(m.user)
            local key = string.lower(username)

            -- Don't show yourself
            if key ~= string.lower(LocalPlayer.Name)
                and not seen[key]
            then
                seen[key] = true

                table.insert(users, {
                    user = username,
                    displayName = tostring(m.displayName or username),
                    jobId = tostring(m.jobId or ""),
                    time = tonumber(m.time) or 0
                })
            end
        end
    end

    return users
end


