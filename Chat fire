local function getRecentMessagePlayers()
    local today = os.date("!%Y-%m-%d", os.time())
    local data = apiReq("/chat/" .. today .. ".json?orderBy=%22t%22&limitToLast=30", "GET")
    if not data or type(data) ~= "table" then return {} end

    local list = {}
    for _, msg in pairs(data) do table.insert(list, msg) end
    table.sort(list, function(a, b) return (tonumber(a.t) or 0) > (tonumber(b.t) or 0) end)

    local users, seen = {}, {}
    for _, m in ipairs(list) do
        if type(m) == "table" and m.u and m.u ~= "" and not m.h then
            local key = string.lower(m.u)
            if key ~= string.lower(LocalPlayer.Name) and not seen[key] then
                seen[key] = true
                table.insert(users, { user = tostring(m.u), displayName = tostring(m.d or m.u), jobId = tostring(m.j or ""), time = tonumber(m.t) or 0 })
            end
        end
    end
    return users
end

