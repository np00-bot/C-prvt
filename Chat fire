        if Connections.Orbit then Connections.Orbit:Disconnect() Connections.Orbit = nil end
        local tPlayer = getPlayer(arg)
        if state == false or not tPlayer then return end
        local angle, speed, radius = 0, 2, 8
        Connections.Orbit = RunService.RenderStepped:Connect(function(dt)
            local char, tChar = LocalPlayer.Character, tPlayer.Character
            if char and tChar and char:FindFirstChild("HumanoidRootPart") and tChar:FindFirstChild("HumanoidRootPart") then
                angle = angle + speed * dt
                local tPos = tChar.HumanoidRootPart.Position
                char.HumanoidRootPart.CFrame = CFrame.new(tPos + Vector3.new(math.cos(angle)*radius, 0, math.sin(angle)*radius), tPos)
                char.HumanoidRootPart.Velocity = Vector3.zero
            end
        end)
    end,
    view = function(arg, state)
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        if state == false then workspace.CurrentCamera.CameraSubject = hum return end
        local target = getPlayer(arg)
        if target and target.Character and target.Character:FindFirstChild("Humanoid") then workspace.CurrentCamera.CameraSubject = target.Character.Humanoid end
    end,
    tp = function(arg)
        local target, char = getPlayer(arg), LocalPlayer.Character
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") and char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = target.Character.HumanoidRootPart.CFrame
        end
    end,
    invisible = function(state)
        local char = LocalPlayer.Character
        if not char then return end
        for _, part in pairs(char:GetDescendants()) do
            if (part:IsA("BasePart") or part:IsA("Decal")) and part.Name ~= "HumanoidRootPart" then
                if state ~= false then
                    OriginalTransparencies[part] = OriginalTransparencies[part] or part.Transparency
                    part.Transparency = 1
                    if part:IsA("ParticleEmitter") or part:IsA("Trail") then part.Enabled = false end
                else
                    part.Transparency = OriginalTransparencies[part] or 0
                    if part:IsA("ParticleEmitter") or part:IsA("Trail") then part.Enabled = true end
                end
            end
        end
    end,
    noclip = function(state)
        if Connections.Noclip then Connections.Noclip:Disconnect() Connections.Noclip = nil end
        if state == false then return end
        Connections.Noclip = RunService.Stepped:Connect(function()
            if LocalPlayer.Character then for _, p in pairs(LocalPlayer.Character:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end end
        end)
    end,
    nosit = function(state)
        if Connections.NoSit then Connections.NoSit:Disconnect() Connections.NoSit = nil end
        if state == false then return end
        Connections.NoSit = RunService.Stepped:Connect(function()
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
            if hum and hum.Sit then hum.Sit = false end
        end)
    end,
    copyserverid = function() pcall(function() if setclipboard then setclipboard(tostring(game.JobId)) else warn("Clipboard not supported.") end end) end
}

