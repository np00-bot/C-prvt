    end
end)

-- Two-Tier Adaptive Polling Loop
local function pollMessages()
    while isPolling do
        task.wait(currentPollRate)
        
        -- Tier 1: Check 10-byte global sync timestamp
        local syncRes = apiReq("/sync.json", "GET")
        local globalSync = tonumber(syncRes)

        if globalSync and globalSync > lastSyncTime then
            -- Snap poll rate back to minimum delay when active
            currentPollRate = BASE_POLL_RATE
            
            -- Tier 2: Fetch missing messages for the partition
            local today = os.date("!%Y-%m-%d", os.time())
            local queryUrl = "/chat/" .. today .. ".json?orderBy=%22t%22&startAt=" .. (lastSyncTime + 1)
            local data = apiReq(queryUrl, "GET")

            if data and type(data) == "table" then
                local newMessages = {}
                for _, msgData in pairs(data) do table.insert(newMessages, msgData) end
                table.sort(newMessages, function(a, b) return (tonumber(a.t) or 0) < (tonumber(b.t) or 0) end)

                for _, m in ipairs(newMessages) do
                    local msgTime = tonumber(m.t) or 0
                    if msgTime > lastSyncTime then
                        lastSyncTime = msgTime
                        knownUsers[m.u:lower()] = m.u

                        -- Invite handler
                        local invSender, invTarget, invJobId = string.match(m.m, "^%( 💌 ([%w_]+) Invite ([%w_]+)%) (.+)$")
                        if invSender and invTarget and invJobId then
                            if invTarget:lower() == LocalPlayer.Name:lower() and invJobId ~= game.JobId then showInviteUI(invSender, invJobId) end
                            continue
                        end

                        -- Hidden system messages handler
                        if m.h then
                            if m.m == "Joined" and m.u:lower() ~= LocalPlayer.Name:lower() then
                                displayMessage(m.u, (m.d or m.u) .. " joined the chat.", nil, false, m.d)
                            end
                            continue
                        end

                        -- Chat scope filter
                        if chatMode == "server" and m.j ~= game.JobId then continue end

                        -- Private message handler
                        local pSender, pTarget, pMsg = string.match(m.m, "^%( 🔐 ([%w_]+) Private ([%w_]+)%) (.*)$")
                        if pSender and pTarget then
                            if LocalPlayer.Name == pSender then displayMessage(m.u, pMsg, pTarget, true) displayBubble(m.u, pMsg)
                            elseif LocalPlayer.Name == pTarget then displayMessage(m.u, pMsg, pSender, false) displayBubble(m.u, pMsg) end
                            continue
                        end

                        checkMention(m.m)
                        displayMessage(m.u, m.m, nil, false, m.d)
                        displayBubble(m.u, m.m)
                    end
                end
            end
        else
            -- Exponential backoff step during idle periods
            currentPollRate = math.min(MAX_POLL_RATE, currentPollRate + POLL_BACKOFF)
        end
    end
end

