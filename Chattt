-- Firebase Realtime Database REST helper.
-- Firebase returns messages as an object keyed by generated message IDs,
-- while the rest of this script expects an array. This helper converts
-- the Firebase response into the same array format used by the old Worker.

local function firebaseUrl(path, query)
    return FIREBASE_URL .. path .. ".json" .. (query or "")
end

local function firebaseDecode(body)
    local ok, data = pcall(HttpService.JSONDecode, HttpService, body)
    return ok and data or nil
end

local function firebaseMessagesToArray(data)
    local result = {}

    if type(data) ~= "table" then
        return result
    end

    for id, message in pairs(data) do
        if type(message) == "table" then
            message._firebaseId = tostring(id)
            table.insert(result, message)
        end
    end

    table.sort(result, function(a, b)
        return (tonumber(a.time) or 0) < (tonumber(b.time) or 0)
    end)

    return result
end

local function apiReq(endpoint, method, body)
    method = method or "GET"

    -- The old script calls /messages?since=TIME.
    -- Map that request to Firebase's ordered REST query.
    if endpoint:sub(1, 9) == "/messages" then
        local since = tonumber(endpoint:match("[?&]since=(%-?%d+)")) or 0

        local query = '?orderBy=%22time%22&startAt=' .. tostring(since + 1)

        local ok, res = pcall(req, {
            Url = firebaseUrl(FIREBASE_MESSAGES_PATH, query),
            Method = "GET",
            Headers = {
                ["Content-Type"] = "application/json",
                ["User-Agent"] = "Roblox/WinInet"
            }
        })

        if ok and res and (res.StatusCode == 200 or res.StatusCode == 204) then
            local data = firebaseDecode(res.Body or "null")
            return firebaseMessagesToArray(data)
        end

        return nil
    end

    -- The old script calls /send with a message table.
    if endpoint == "/send" and method == "POST" then
        if type(body) ~= "table" then
            return nil
        end

        body.time = tonumber(body.time) or os.time()

        local ok, res = pcall(req, {
            Url = firebaseUrl(FIREBASE_MESSAGES_PATH),
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["User-Agent"] = "Roblox/WinInet"
            },
            Body = HttpService:JSONEncode(body)
        })

        if ok and res and (res.StatusCode == 200 or res.StatusCode == 201) then
            return firebaseDecode(res.Body or "{}") or {}
        end

        return nil
    end

    return nil
end

local function toLowerKeys(tbl)
    local newTbl = {}
    if type(tbl) == "table" then
        for k, v in pairs(tbl) do newTbl[type(k) == "string" and k:lower() or k] = v end
    end
    return newTbl
end

