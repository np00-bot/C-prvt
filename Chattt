    end
end)

-- Polling Loop
local function pollMessages()
    while isPolling do
        task.wait(2)
        local data = apiReq("/messages?since=" .. tostring(lastSyncTime))
        if data and type(data) == "table" then
            for _, m in ipairs(data) do
                if m.time > lastSyncTime then
                    lastSyncTime = m.time
                    knownUsers[m.user:lower()] = m.user

                    local invSender, invTarget, invJobId = string.match(m.msg, "^%( ðŸ’Œ ([%w_]+) Invite ([%w_]+)%) (.+)$")
                    if invSender and invTarget and invJobId then
                        if invTarget:lower() == LocalPlayer.Name:lower() and invJobId ~= game.JobId then showInviteUI(invSender, invJobId) end
                        continue
                    end

                    if m.hidden then
                        if m.msg == "Joined" and m.user:lower() ~= LocalPlayer.Name:lower() then
                            displayMessage(m.user, (m.displayName or m.user) .. " joined the chat.", nil, false, m.displayName)
                        end
                        continue
                    end

                    if chatMode == "server" and m.jobId ~= game.JobId then continue end

                    local pSender, pTarget, pMsg = string.match(m.msg, "^%( ðŸ” ([%w_]+) Private ([%w_]+)%) (.*)$")
                    if pSender and pTarget then
                        if LocalPlayer.Name == pSender then displayMessage(m.user, pMsg, pTarget, true) displayBubble(m.user, pMsg)
                        elseif LocalPlayer.Name == pTarget then displayMessage(m.user, pMsg, pSender, false) displayBubble(m.user, pMsg) end
                        continue
                    end

                    checkMention(m.msg)
                    displayMessage(m.user, m.msg, nil, false, m.displayName)
                    displayBubble(m.user, m.msg)
                end
            end
        end
    end
end

