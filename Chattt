-- Messaging & Input System
local function sendPrivateMessage()
    local text = TextBox.Text
    if not text or text == "" then return end
    if processCommand(text) then TextBox.Text = "" return end

    local lowerText = text:gsub("%s+", ""):lower()
    TextBox.Text = ""

    if lowerText == "!cmds" then
        displayMessage("System", "Commands:\n- fly, unfly\n- speed [num], jumppower [num]\n- spin, unspin, orbit [user], unorbit\n- view [user], unview, tp [user]\n- invisible, visible, noclip, clip, sit, nosit\n- copyserverid\n- !p (private chat)\n- !i (invite player)")
        return
    elseif lowerText == "!server" or lowerText == "!global" then
        chatMode = lowerText:sub(2)
        displayMessage("System", "Chat mode switched to " .. chatMode:upper() .. ".")
        return
    end

    local finalMsg = privateTarget and ("( ðŸ” " .. LocalPlayer.Name .. " Private " .. privateTarget .. ") " .. text) or text
    TextBox.PlaceholderText = " Sending..."

    task.spawn(function()
        local res = apiReq("/send", "POST", { user = LocalPlayer.Name, displayName = LocalPlayer.DisplayName, msg = finalMsg, jobId = game.JobId, private = privateTarget ~= nil, source = "roblox", time = os.time() })
        TextBox.PlaceholderText = res and " press ; to type.." or " Failed! Server offline?"
        if not res then task.wait(2) TextBox.PlaceholderText = " press ; to type.." end
    end)
end

TextBox.FocusLost:Connect(function(e) if e then sendPrivateMessage() end end)
