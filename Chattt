    for i = #data, math.max(1, #data - 14), -1 do
        local m = data[i]
        if type(m) == "table" and m.user and m.user ~= "" and not m.hidden then
            local key = string.lower(m.user)
            if key ~= string.lower(LocalPlayer.Name) and not seen[key] then
                seen[key] = true
                table.insert(users, { user = tostring(m.user), displayName = tostring(m.displayName or m.user), jobId = tostring(m.jobId or ""), time = tonumber(m.time) or 0 })
            end
        end
    end
    return users
end

