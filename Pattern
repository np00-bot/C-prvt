local function getRevOff(i, tot, r, t)
    local x,y,z, pR, rR = 0,0,0, i/tot, (i/tot)*m_pi*2
    if actRev=="Spin" then x,z = m_cos(rR+t)*r, m_sin(rR+t)*r
    elseif actRev=="Reverse Spin" then x,z = m_cos(rR-t)*r, m_sin(rR-t)*r
    elseif actRev=="Bobbing Orbit" then x,z,y = m_cos(rR+t)*r, m_sin(rR+t)*r, m_sin((t*2)+rR)*(r/1.5)
    elseif actRev=="Vertical Halo" then z,x,y = (r/1.5)+2, m_cos(rR+t)*r, m_sin(rR+t)*r
    elseif actRev=="Back Chakra" then z,x,y = 3, m_cos(rR+t)*r, m_sin(rR+t)*r
    elseif actRev=="Line Wise" then x,y = (i-tot/2)*(r/5), m_sin(t+i)*(r/3)
    elseif actRev=="2 Ring" then local r2, sm = (i%2==0 and r or r/1.5), (i%2==0 and 1 or -1); x,z = m_cos(rR+(t*sm))*r2, m_sin(rR+(t*sm))*r2
    elseif actRev=="3 Ring" or actRev=="Atom" then local rg, a = i%3, rR+t; if rg==0 then x,z=m_cos(a)*r, m_sin(a)*r elseif rg==1 then x,y=m_cos(a)*r, m_sin(a)*r else y,z=m_cos(a)*r, m_sin(a)*r end
    elseif actRev=="Spiral" then local a=(i/tot)*m_pi*4; x,z,y = m_cos(a+t)*r, m_sin(a+t)*r, ((tot-i)-tot/2)*(r/5)
    elseif actRev=="Tornado" then local cr=r*pR; y,x,z = (pR*r)-(r/2), m_cos(rR+t*2)*cr, m_sin(rR+t*2)*cr
    elseif actRev=="Wheel" then x,y = m_cos(rR)*r, m_sin(rR)*r; x,y = x*m_cos(t)-y*m_sin(t), x*m_sin(t)+y*m_cos(t)
    elseif actRev=="Modern Spin" then x,z = m_cos(rR+t)*r, m_sin(rR+t)*r; local tl = m_rad(90); z,y = z*m_cos(tl), z*m_sin(tl)
    elseif actRev=="Wave" then z,x = -r+2, (i-tot/2)*(r/3); y = m_sin(t+x)*(r/2)
    elseif actRev=="Cross" then local a, d = i%4, (m_ceil(i/4)/(tot/4))*r; if a==0 then x=d elseif a==1 then x=-d elseif a==2 then z=d else z=-d end
    elseif actRev=="Galaxy Spiral" then local r1, sa = pR*r+(r*0.2), pR*m_pi*2+t; if i%2==1 then sa=sa+m_pi end; x,z = m_cos(sa)*r1, m_sin(sa)*r1
    elseif actRev=="Crown" then y = (r/1.5)+3; x,z = m_cos(rR+t)*r, m_sin(rR+t)*r; y = y+m_sin(rR)*(r*0.2)
    elseif actRev=="DNA" then local p = (i%2==0 and 0 or m_pi); y = (i-(tot/2))*(r/10); x,z = m_cos((i*0.5)+t+p)*r, m_sin((i*0.5)+t+p)*r
    elseif actRev=="Wings" then local sd, io = (i%2==0 and 1 or -1), m_ceil(i/2); x,y,z = sd*(io*(r/5)), io*(r/10), io*(r/5)
    elseif actRev=="Discipline Army" then local c=m_ceil(m_sqrt(tot)); local cl,rw=(i-1)%c, m_floor((i-1)/c); x,z = (cl-c/2)*(r/2), (rw-c/2)*(r/2)
    elseif actRev=="Flower" then local r1=r*m_cos(5*rR+t); x,z = r1*m_cos(rR), r1*m_sin(rR)
    elseif actRev=="Domain Expansion" then local p, th = m_acos(1-2*pR), m_sqrt(tot*m_pi)*m_acos(1-2*pR)+t; x,y,z = r*m_sin(p)*m_cos(th), r*m_sin(p)*m_sin(th), r*m_cos(p)
    elseif actRev=="Snake Body" then x,z = m_sin(t-(i*0.2))*r, (i*(r/5)) end
    return Vector3.new(x,y,z)
end

local function getRotCF(i, r, t)
    if actRot=="Normal Rotate" then return CFrame.Angles(0,t*2,0)
    elseif actRot=="Up Down" then return CFrame.new(0,m_sin(t*4)*(r/3),0)
    elseif actRot=="Wave" then return CFrame.new(0,m_sin(t*4+(i%2==0 and 0 or m_pi))*(r/3),0)
    elseif actRot=="Side to Side" then return CFrame.new(0,0,m_sin(t*4)*(r/3))
    elseif actRot=="Side Wave" then return CFrame.new(0,0,m_sin(t*4+(i%2==0 and 0 or m_pi))*(r/3))
    elseif actRot=="Glitchy" then return CFrame.new(math.random(-1,1)*(r/10), math.random(-1,1)*(r/10), math.random(-1,1)*(r/10)) * CFrame.Angles(math.random(),math.random(),math.random())
    elseif actRot:match("Axis") then return actRot=="Tilt Axis" and CFrame.Angles(t*2,0,0) or CFrame.Angles(0,0,t*2)
    elseif actRot=="Chaos" then return CFrame.Angles(t*3,t*2.5,t*3.5)
    elseif actRot=="Heartbeat" then return CFrame.new(0,0,(m_sin(t*8)>0.8 and r/2 or 0))
    elseif actRot=="Nodding" then return CFrame.Angles(m_sin(t*4),0,0)
    elseif actRot=="Shaking" then return CFrame.Angles(0,m_sin(t*8),0)
    elseif actRot=="Orbit Self" then return CFrame.Angles(0,t*5,0)
    elseif actRot=="Propeller" then return CFrame.Angles(0,0,t*5)
    elseif actRot=="Pendulum" then return CFrame.Angles(0,0,m_sin(t*3))*CFrame.new(0,-r/4,0)
    elseif actRot=="Breathing" then return CFrame.new(0,0,m_sin(t*2)*(r/4))
    elseif actRot=="Tremor" then return CFrame.new(m_sin(t*20)*0.5,0,m_cos(t*20)*0.5)
    elseif actRot=="Flipping" then return CFrame.Angles(t*4,0,0)
    elseif actRot=="Bounce" then return CFrame.new(0,m_abs(m_sin(t*4))*(r/2),0)
    elseif actRot=="ZigZag" then return CFrame.new(0,(t*5%2)-1,(t*3%2)-1)
    elseif actRot=="Spiral Self" then return CFrame.new(0,m_sin(t*3)*(r/4),0)*CFrame.Angles(0,t*4,0) end
    return CFrame.new()
end

local function getRbtOff(i, tg)
    local t, f = (i%2==0) and not tg or tg, CFrame.Angles(0,m_pi,0)
    if i==1 then return (t and CFrame.new(0,-4,1.8) or CFrame.new(0,-4,-0.5))*f
    elseif i==2 then return t and CFrame.new(-1.5,-4,-2.5) or CFrame.new(1.5,-4,-2.5)
    elseif i==3 then return t and CFrame.new(0,-1,-3.5) or CFrame.new(0,-1,-1.5)
    elseif i==4 then return (t and CFrame.new(3,-4,0) or CFrame.new(1.5,-4,0))*CFrame.Angles(0,-m_pi/2,0)
    elseif i==5 then return (t and CFrame.new(-3,-4,0) or CFrame.new(-1.5,-4,0))*CFrame.Angles(0,-m_pi/2,0)
    else local da, y = (i*m_pi*2)/7, -4+((i%4)*1.2); local p = Vector3.new(m_sin(da)*(t and 3.5 or 1.5), y, m_cos(da)*(t and 3.5 or 1.5)); return CFrame.lookAt(p, Vector3.new(0,y,0))*f end
end

local cEvt = lp.PlayerGui:WaitForChild("NoResetGUIHandler"):WaitForChild("PropColorPicker"):WaitForChild("SetColor")
local lCol = 0

RS.Heartbeat:Connect(function(dt)
    local now = tick()
    if rgbMode ~= "OFF" and #cPartsRGB > 0 then
        local c
        if rgbMode == "Dyna" then c = Color3.fromHSV((now*0.2)%1,1,1)
        elseif rgbMode == "Shift" then c = Color3.fromHSV((m_floor(now*2)/2)%1,1,1)
        elseif rgbMode == "Disco" and m_floor(now*10)%3==0 then c = Color3.fromHSV(math.random(),1,1) end
        if c then
            for i=1,#cPartsRGB do cPartsRGB[i].Color = c end
            if now-lCol >= 0.15 then lCol=now; pcall(function() cEvt:FireServer(c) end) end
        end
    end

    if actMode == "None" then return end; updateCache()
    if #cProps == 0 then if now-lStart > 3 then actMode = "None"; notif("System", "No props exist. Stopped automatically.", 3) end return end
    
    local tgts = {}
    for p, s in pairs(selPlrs) do if s and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") then table.insert(tgts, p) end end
    local tC = #tgts; if tC == 0 then return end
    local doNet = false; if now-lNet >= NET_RT then lNet=now; doNet=true end

    if actMode:match("Robot|Slide|Chair") then
        if not lckProp or not lckProp.Parent then lckProp = cProps[1].prop end
        if lckProp and lckProp.Parent then
            pcall(function() lckProp:PivotTo(CFrame.new(LCK_POS)) end)
            if now-lDup >= DUP_INT then lDup=now; local dp = lckProp:FindFirstChild("DuplicateProp"); if dp then for i=1,14 do task.spawn(function() pcall(function() dp:InvokeServer() end) end) end end end
        end
    else lckProp = nil end

    if actMode == "Orbit" then
        local r, s, cY, cOf = getR(), getS()/100, getCY(), CFrame.new(0, getCY(), 0) * CFrame.Angles(m_rad(getRX()), m_rad(getRY()), m_rad(getRZ()))
        ang = ang + (s*(dt*60))
        for i, item in ipairs(cProps) do
            local tIdx, pPT = ((i-1)%tC)+1, m_ceil(#cProps/tC)
            local cf = (tgts[tIdx].Character.HumanoidRootPart.CFrame * cOf) * CFrame.new(getRevOff(i%pPT, pPT, r, ang)) * getRotCF(i%pPT, r, ang)
            pcall(function() item.prop:PivotTo(cf) end); if doNet then task.spawn(function() pcall(function() item.remote:InvokeServer(cf) end) end) end
        end

    elseif actMode:match("Robot|Slide") and now-lRbt >= RBT_RT then
        lRbt, rbtTog = now, not rbtTog
        for ti, p in ipairs(tgts) do
            local leg = p.Character:FindFirstChild("LeftFoot") or p.Character:FindFirstChild("Left Leg") or p.Character:FindFirstChild("RightFoot") or p.Character:FindFirstChild("Right Leg")
            if leg then
                local vel = leg.AssemblyLinearVelocity; local spd = vel.Magnitude
                local pCF = (spd>=30 and spd<=30.1) and (leg.CFrame + (vel*P_FAC)) or leg.CFrame
                local pPT = math.max(1, m_floor(#cProps/tC))
                local sI, eI = ((ti-1)*pPT)+1, (ti==tC) and #cProps or (ti*pPT)
                
                local lI = 1
                for i=sI, eI do
                    local itm = cProps[i]
                    if itm and itm.prop ~= lckProp then
                        local fCF
                        if tC < 6 then
                            local ph, th = m_acos(1-2*(lI/pPT)), m_pi*(1+m_sqrt(5))*lI
                            local rM = 2+m_sin(now*100*((lI%2==0) and 2 or 1))*2
                            fCF = CFrame.lookAt(pCF.Position + Vector3.new(rM*m_sin(ph)*m_cos(th), rM*m_sin(ph)*m_sin(th), rM*m_cos(ph)), pCF.Position) * CFrame.Angles(0,m_pi,0)
                        else fCF = pCF * getRbtOff(lI, rbtTog) end
                        task.spawn(function() pcall(function() itm.remote:InvokeServer(fCF) end) end); lI = lI+1
                    end
                end
            end
        end

    elseif actMode == "Chair" then
        local aTrk = {}
        for _, p in ipairs(tgts) do
            local rt, hum = p.Character:FindFirstChild("LeftFoot") or p.Character:FindFirstChild("Left Leg"), p.Character.Humanoid
            voidPlrs[p] = (rt.Position.Y < -500); local mI = assItems[p]
            
            if not mI or not mI.prop.Parent then
                for _, rI in ipairs(cProps) do if rI.prop ~= lckProp and not aTrk[rI.remote] then mI=rI; assItems[p]=rI; break end end
            end
            if mI then
                aTrk[mI.remote] = true
                if not voidPlrs[p] then task.spawn(function() pcall(function() mI.remote:InvokeServer(hum.Sit and CFrame.new(rt.Position.X,-1000,rt.Position.Z) or (rt.CFrame*CFrame.new(0,-2.5,0))) end) end) end
            end
        end
    end
end)
