    local function upd(i) local pos = math.clamp((i.Position.X-b.AbsolutePosition.X)/b.AbsoluteSize.X, 0, 1); f.Size = UDim2.new(pos,0,1,0); v = m_floor(mn+pos*(mx-mn)); l.Text = n..": "..v end
    b.InputBegan:Connect(function(i) if i.UserInputType.Name:match("MouseButton1|Touch") then drg = true; upd(i) end end); b.InputEnded:Connect(function(i) if i.UserInputType.Name:match("MouseButton1|Touch") then drg = false end end)
    UIS.InputChanged:Connect(function(i) if drg and i.UserInputType.Name:match("MouseMovement|Touch") then upd(i) end end)
    return function() return v end
end

