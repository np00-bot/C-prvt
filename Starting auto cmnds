--------------------------------------------------
-- FPS TRACKING
--------------------------------------------------

local currentFPS = 60
local frameCount = 0
local fpsTimer = 0

RunService.RenderStepped:Connect(function(deltaTime)
	frameCount += 1
	fpsTimer += deltaTime

	if fpsTimer >= 1 then
		currentFPS = frameCount / fpsTimer
		frameCount = 0
		fpsTimer = 0
	end
end)

--------------------------------------------------
-- DETECTOR
--------------------------------------------------

local detectorRunning = true
local asking = false
local badChecks = 0

local function stopDetector()
	detectorRunning = false
	asking = false
	frame.Visible = false
end

local function showLagPrompt()
	if asking or not detectorRunning then
		return
	end

	asking = true
	frame.Visible = true

	text.Text = string.format(
		"Are you lagging?\nPing: %dms | FPS: %d",
		math.round(currentPing or 0),
		math.round(currentFPS)
	)
end

--------------------------------------------------
-- BUTTONS
--------------------------------------------------

reduceButton.Activated:Connect(function()
	if not detectorRunning then
		return
	end

	frame.Visible = false
	asking = false

	runAntiLag()

	-- Stop checking after anti-lag is enabled
	stopDetector()
end)

noButton.Activated:Connect(function()
	-- User doesn't want anti-lag.
	-- Stop the detector completely.
	stopDetector()
end)

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------

local currentPing = 0

task.spawn(function()
	while detectorRunning do
		task.wait(CHECK_INTERVAL)

		if not detectorRunning or asking then
			continue
		end

		local success, ping = pcall(function()
			return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
		end)

		if success and ping then
			currentPing = ping

			local highPing = ping >= PING_THRESHOLD
			local lowFPS = currentFPS <= FPS_THRESHOLD

			if highPing or lowFPS then
				badChecks += 1
			else
				badChecks = 0
			end

			-- Require 3 consecutive bad checks
			-- to avoid triggering from a brief spike.
			if badChecks >= REQUIRED_BAD_CHECKS then
				showLagPrompt()
			end
		end
	end
end)

